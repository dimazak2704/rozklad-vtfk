# Скопіюйте в .env (він у .gitignore, ніколи не комітьте). Значення нижче — для запуску сервісів на хості;
# у docker compose адреси інфраструктури перевизначаються в infra/docker-compose.yml.
# Spring Boot сам .env не читає: scripts/run-local.sh <service> експортує ці змінні перед запуском jar.
# DB_NAME / DB_USER / DB_PASSWORD тут не задаються: кожен сервіс типово бере власну базу (core/core/core, …).

# --- PostgreSQL 18 (docker, порт хоста 5433) ---
DB_HOST=localhost
DB_PORT=5433
POSTGRES_PASSWORD=postgres

# --- RabbitMQ 4.4 ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=rozklad
RABBIT_PASSWORD=rozklad

# --- Redis 8 ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Сервіс входу services/auth (OIDC-видавець; у docker compose адреси задає infra/docker-compose.yml) ---
# перевірка токенів у core, importer, notification, scheduler: iss — як бачить браузер (nginx контейнера web),
# ключі — напряму з опублікованого порту auth; кожен токен має містити AUTH_AUDIENCE в aud
AUTH_ISSUER=http://localhost:8088/auth
AUTH_JWKS_URI=http://localhost:8085/auth/oauth2/jwks
AUTH_AUDIENCE=rozklad-api
# сервісні токени (client credentials) notification, importer і core; секрети — лише dev-значення
AUTH_TOKEN_URI=http://localhost:8085/auth/oauth2/token
NOTIFICATION_CLIENT_SECRET=dev-notification-secret
IMPORTER_CLIENT_SECRET=dev-importer-secret
# секрет клієнта rozklad-core (core веде облікові записи через внутрішній API auth)
CORE_AUTH_CLIENT_SECRET=dev-core-auth-secret
# core, запущений на хості: внутрішній API auth на опублікованому порту 8085
AUTH_INTERNAL_URL=http://localhost:8085/auth/internal
# rozklad-cli: токени для скриптів і e2e-real через код + PKCE (scripts/rozklad_auth.py); на сервері вимкнено
AUTH_CLI_ENABLED=true
# ключ підпису токенів: PKCS#8 PEM (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048);
# порожньо — ключ у пам'яті (лише розробка, після перезапуску всі входять знову)
AUTH_SIGNING_KEY_FILE=
AUTH_SIGNING_KEY_ID=dev
# перший адміністратор, якщо жодного немає (пароль — щонайменше 12 символів); прибрати після першого входу
AUTH_BOOTSTRAP_ADMIN_USERNAME=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# вхід через Google (docs/GOOGLE_SIGNIN.md): порожній client id = кнопки Google немає. Локально замість
# Google — mock: scripts/dev-stack.sh up --google-mock (ці змінні тоді задає infra/docker-compose.google-mock.yml)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# домен Workspace коледжу; порожньо — без правила домену (лише локально)
AUTH_GOOGLE_HOSTED_DOMAIN=

# --- Адреси сервісів ---
CORE_URL=http://localhost:8081
SCHEDULER_URL=http://localhost:8082
IMPORTER_URL=http://localhost:8083
NOTIFICATION_URL=http://localhost:8084
PUBLIC_WEB_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:8088

# --- «Машина часу» стенду (лише розробка, docs/RUNNING.md): core, importer і notification живуть так, ніби
# зараз цей київський час, і годинник іде далі; порожньо — реальний час. Зручніше: dev-stack.sh up --time …
# (скрипт сам ставить і ANCHOR — реальну мить, до якої прив'язано час). З https-видавцем сервіси не стартують
ROZKLAD_STAND_TIME=
ROZKLAD_STAND_TIME_ANCHOR=

# --- Стенд для телефона в локальній мережі (лише розробка, docs/RUNNING.md «Phone on the LAN»): ці змінні
# ставить dev-stack.sh up --lan через infra/docker-compose.lan.yml; у .env їх не записуйте. LAN_DEV лишає
# https-видавця на приватній IPv4-адресі розробкою; з доменом чи публічною адресою auth не стартує.
# Ключ доступу (ROZKLAD_LAN_KEY) dev-stack.sh створює сам і зберігає в infra/dev/certs/lan-key (gitignored)
# ROZKLAD_LAN_IP=192.168.1.20
# ROZKLAD_LAN_DEV=false

# --- Gateway: ліміт публічного API на IP ---
PUBLIC_RATE_LIMIT_PER_SECOND=20
PUBLIC_RATE_LIMIT_BURST=40

# --- AI (importer) ---
ANTHROPIC_API_KEY=
AI_MODEL_TEXT=claude-haiku-5-5
AI_MODEL_VISION=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=2.00
# parse-absence для бота: тайм-аут без повторів (бот чекає 20 с)
AI_INTERACTIVE_TIMEOUT=10s

# --- Telegram (notification) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=scheduler_vtfk_bot
TELEGRAM_MODE=POLLING
TELEGRAM_WEBHOOK_SECRET=

# --- Листи на пошту (notification): порожній MAIL_HOST — листів немає. У docker compose стенду ці значення
# перекриває infra/docker-compose.yml (Mailpit, http://127.0.0.1:8025), тож справжні тут на стенд не потраплять.
# Сервіс на хості з Mailpit стенду: MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_STARTTLS=false.
# Стенд (http) не надсилає на справжній сервер без MAIL_ALLOW_REAL_SMTP=true ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_FROM=Розклад ВТФК <rozklad@rozklad.local>
MAIL_REPLY_TO=
MAIL_TRUSTED_DOMAINS=vtc.vn.ua
MAIL_ALLOW_REAL_SMTP=false

# --- LibreOffice: у контейнерах soffice, на хості порожньо ⇒ конвертація вимкнена ---
SOFFICE_PATH=

# --- Логи: у compose LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs (JSON), на хості — звичайний текст ---
