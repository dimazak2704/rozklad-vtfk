# Скопіюйте в .env (він у .gitignore, ніколи не комітьте). Значення нижче — для запуску сервісів на хості;
# у docker compose адреси інфраструктури перевизначаються в infra/docker-compose.yml.
# Spring Boot сам .env не читає: scripts/run-local.sh <service> експортує ці змінні перед запуском jar.
# DB_NAME / DB_USER / DB_PASSWORD тут не задаються: кожен сервіс типово бере власну базу (core/core/core, …).

# --- PostgreSQL 18 (docker, порт хоста 5433) ---
DB_HOST=localhost
DB_PORT=5433
POSTGRES_PASSWORD=postgres

# --- RabbitMQ 4.4 ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=rozklad
RABBIT_PASSWORD=rozklad

# --- Redis 8 ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Keycloak 26 (realm rozklad) ---
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=rozklad
KEYCLOAK_ISSUER=http://localhost:8180/realms/rozklad
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/rozklad/protocol/openid-connect/certs
KEYCLOAK_ADMIN_PASSWORD=admin
# секрети клієнтів — dev-значення з infra/keycloak/rozklad-realm.json
CORE_ADMIN_CLIENT_SECRET=dev-core-admin-secret
NOTIFICATION_CLIENT_SECRET=dev-notification-secret
IMPORTER_CLIENT_SECRET=dev-importer-secret

# --- Адреси сервісів ---
CORE_URL=http://localhost:8081
SCHEDULER_URL=http://localhost:8082
IMPORTER_URL=http://localhost:8083
NOTIFICATION_URL=http://localhost:8084
PUBLIC_WEB_URL=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:8088

# --- Gateway: ліміт публічного API на IP ---
PUBLIC_RATE_LIMIT_PER_SECOND=20
PUBLIC_RATE_LIMIT_BURST=40

# --- AI (importer) ---
ANTHROPIC_API_KEY=
AI_MODEL_TEXT=claude-haiku-5-5
AI_MODEL_VISION=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=2.00

# --- Telegram (notification) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=scheduler_vtfk_bot
TELEGRAM_MODE=POLLING
TELEGRAM_WEBHOOK_SECRET=

# --- LibreOffice: у контейнерах soffice, на хості порожньо ⇒ конвертація вимкнена ---
SOFFICE_PATH=

# --- Логи: у compose LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs (JSON), на хості — звичайний текст ---
