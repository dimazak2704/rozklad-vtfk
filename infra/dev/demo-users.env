# Тестові облікові записи локального стенда (лише розробка; на сервері паролі інші й живуть у .env).
# Сервіс входу (services/auth) створює їх під час старту з AUTH_DEMO_SEED=true: admin = ADMIN,
# krentsin і nepyivoda = TEACHER, з тими самими id, що й демо-зв'язки core. docker compose передає файл
# у контейнер auth (env_file); скрипти й e2e-real читають його для входу.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
TEACHER_USERNAME=krentsin
TEACHER_PASSWORD=teacher
TEACHER2_USERNAME=nepyivoda
TEACHER2_PASSWORD=teacher
