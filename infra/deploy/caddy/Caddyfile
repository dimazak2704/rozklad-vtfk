# Edge proxy of «Розклад ВТФК» in production (infra/deploy/compose.prod.yml, docs/DEPLOY.md).
#
#   https://{$DOMAIN}        SPA (web:80), /api/* -> gateway:8080, /auth/* -> auth:8085 (sign-in, OIDC)
#                            One origin for everything, so no CORS is needed.
#
# Caddy gets and renews the Let's Encrypt certificate by itself; the name must resolve to this server
# and ports 80/443 must be open. There is no access log (no `log` directive), so the codes and tokens
# in the query strings of /auth/* are not written anywhere. {$VAR} values come from the container
# environment (set in compose.prod.yml) and are substituted when the file is loaded.
# compose.prod.yml mounts this directory, not the file: after `git pull` the container sees the new
# file, and deploy.sh runs `caddy reload` (a bind-mounted single file would keep the old inode).
{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

# ---- snippets (defined before use) ----------------------------------------------------------------

(security_headers) {
	header {
		# one year; no includeSubDomains, so other hosts of the domain are not affected
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options "nosniff"
		# only if the upstream did not set its own
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

(compress) {
	encode zstd gzip
}

# Forwarding headers a client could forge. Caddy itself replaces X-Forwarded-For, -Proto and -Host
# (it trusts no proxy in front of it), but passes these through. The gateway reads forwarding
# headers (SERVER_FORWARD_HEADERS_STRATEGY=native) and Reactor Netty prefers RFC 7239 `Forwarded`
# over X-Forwarded-For, so `Forwarded: for=<random>` would give every request its own bucket of the
# per-IP rate limit. Every site imports this before anything is proxied.
(strip_client_forwarding) {
	request_header -Forwarded
	request_header -X-Forwarded-Port
	request_header -X-Forwarded-Prefix
	request_header -X-Real-IP
}

# /api/* -> gateway. Used by the main site and by the optional api.{$DOMAIN} site.
(api_routes) {
	# Server-sent events: no compression, every event is flushed at once, no timeout
	handle /api/events/stream {
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}
	handle /api/* {
		import compress
		reverse_proxy gateway:8080 {
			flush_interval -1
		}
	}
}

# The sign-in service with its own context path /auth (paths pass unchanged). Caddy sets
# X-Forwarded-Proto/-Host/-For itself, so auth builds its redirects for https://{$DOMAIN}. The internal
# accounts API is for core inside the network only; the actuator listens on another port (8086).
(auth_routes) {
	@auth_private path /auth/internal /auth/internal/*
	handle @auth_private {
		respond "Not found" 404
	}
	handle /auth/* {
		import compress
		reverse_proxy auth:8085
	}
}

# ---- sites -----------------------------------------------------------------------------------------

{$DOMAIN} {
	import strip_client_forwarding
	import security_headers
	import api_routes
	import auth_routes

	# SPA: nginx in the web container (static files, SPA fallback to index.html, cache headers, CSP)
	handle {
		import compress
		reverse_proxy {$WEB_UPSTREAM:web:80}
	}
}
