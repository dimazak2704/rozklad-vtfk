# Production settings of «Розклад ВТФК» for one VPS (docs/DEPLOY.md). No real values here.
#
#   infra/deploy/scripts/gen-secrets.sh    creates infra/deploy/.env from this file and replaces
#                                          every "change-me" with a random value
#   then edit infra/deploy/.env: DOMAIN, ACME_EMAIL, Telegram and Anthropic keys
#
# infra/deploy/.env is gitignored: never commit it. Keep a copy in a password manager: a database
# backup cannot be used without the passwords and client secrets it was made with.
# Format: KEY=value, one per line, no quotes and no spaces around "=".

# ---- Public addresses ----------------------------------------------------------------------------
# Host name only (no https://, no path). Everything is served at https://DOMAIN: the SPA, the API under
# /api and the sign-in service under /auth. The name must point to the VPS. Free options: <ip-with-dashes>.sslip.io (for 203.0.113.10 it is
# 203-0-113-10.sslip.io, nothing to register), <name>.duckdns.org, or a GitHub Student Pack domain.
DOMAIN=rozklad.example.com
# Let's Encrypt account e-mail (certificate expiry warnings). example.com addresses are refused.
ACME_EMAIL=admin@example.com
# Certificate authority. For the very first experiments you can use the staging CA (browsers will
# warn, but its rate limits are high): https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ---- Images ------------------------------------------------------------------------------------
# Usually leave both unset. Without them deploy.sh builds localhost/rozklad/<service>:prod on the VPS,
# or, once the GitHub workflow has deployed ghcr.io/<owner>/rozklad/<service>:<commit sha>, keeps
# using what was deployed last: deploy.sh records the running images in infra/deploy/.env.images,
# and compose.sh, restore-db.sh and backup-db.sh read that record. Set them only to pin other
# images; a prefix with a registry (ghcr.io/...) means pulling, localhost/... means building here.
#IMAGE_PREFIX=ghcr.io/<owner-lowercase>/rozklad
#IMAGE_TAG=<commit sha>
# The only image prefix the GitHub deploy key may roll out (ci-entry.sh). Unset = ghcr.io/<GitHub owner
# of the clone's origin, lower-case>/rozklad; set it if origin is not a GitHub URL.
#DEPLOY_IMAGE_PREFIX=ghcr.io/<owner-lowercase>/rozklad

# ---- PostgreSQL: superuser and one user per service database ----------------------------------
# Applied when the database volume is created for the first time.
POSTGRES_PASSWORD=change-me
CORE_DB_PASSWORD=change-me
SCHEDULER_DB_PASSWORD=change-me
IMPORTER_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me

# ---- RabbitMQ and Redis --------------------------------------------------------------------------
RABBIT_USER=rozklad
RABBIT_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ---- Sign-in service (services/auth) -------------------------------------------------------------
# Secrets of the service clients: notification and importer get tokens with them, core manages
# accounts through the internal API of auth. auth registers them at every start.
NOTIFICATION_CLIENT_SECRET=change-me
IMPORTER_CLIENT_SECRET=change-me
CORE_AUTH_CLIENT_SECRET=change-me
# kid of the token signing key infra/deploy/secrets/auth-signing-key.pem (gen-secrets.sh creates both).
AUTH_SIGNING_KEY_ID=change-me
# The first admin (docs/DEPLOY.md, "First admin"). auth applies it only while no admin can sign in:
# it creates the account (or repairs the one with this username) with this password. After your first
# sign-in, empty the password (AUTH_BOOTSTRAP_ADMIN_PASSWORD=) and run deploy.sh again.
# AUTH_BOOTSTRAP_FORCE=true resets the password of this account even when other admins exist.
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me
AUTH_BOOTSTRAP_FORCE=false
# Sign-in with Google (docs/GOOGLE_SIGNIN.md). Empty client id = no Google button, password sign-in only.
# The hosted domain is required with Google on (auth refuses to start without it).
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_HOSTED_DOMAIN=vtc.vn.ua

# ---- Demo accounts for the defense ---------------------------------------------------------------
# auth creates the teachers krentsin and nepyivoda (the ids of the demo data) with this password at
# every start. Empty = they are switched off and signed out. At least 12 characters.
DEMO_TEACHER_PASSWORD=change-me

# ---- Telegram bot (notification) -----------------------------------------------------------------
# Token from @BotFather. One token can be polled by one instance only: stop the local bot first.
TELEGRAM_BOT_TOKEN=
# Chat id of the owner/dispatcher for service messages.
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=scheduler_vtfk_bot
# POLLING needs no inbound connection. WEBHOOK posts to https://DOMAIN/api/notify/telegram/webhook
# (compose.prod.yml derives TELEGRAM_WEBHOOK_URL from DOMAIN; set it here only to override).
TELEGRAM_MODE=POLLING
# Checked in the X-Telegram-Bot-Api-Secret-Token header (WEBHOOK mode only).
TELEGRAM_WEBHOOK_SECRET=change-me

# ---- E-mail (notification, docs/DEPLOY.md section 10a) -------------------------------------------
# Empty MAIL_HOST = no letters (the default). Google Workspace: smtp.gmail.com:587 with STARTTLS, a service
# mailbox and an app password, or the Workspace SMTP relay smtp-relay.gmail.com:587.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
# App password of the service mailbox (never the personal password of anyone).
MAIL_PASSWORD=
# true for port 587; for implicit TLS on 465 set MAIL_SSL=true and MAIL_STARTTLS=false.
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_FROM=Розклад ВТФК <rozklad@vtc.vn.ua>
# Optional: where a teacher's reply lands (the dispatcher office); letters say replies are not read by the system.
MAIL_REPLY_TO=
# An account address on these domains counts as verified without Google sign-in; empty = Google sign-in only.
MAIL_TRUSTED_DOMAINS=vtc.vn.ua

# ---- AI extraction (importer) --------------------------------------------------------------------
# Key from console.anthropic.com. Empty = AI import is unavailable, deterministic parsers still work.
ANTHROPIC_API_KEY=
AI_MODEL_TEXT=claude-haiku-5-5
AI_MODEL_VISION=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=2.00

# ---- Gateway -------------------------------------------------------------------------------------
# Token bucket per client IP for /api/public/**.
PUBLIC_RATE_LIMIT_PER_SECOND=20
PUBLIC_RATE_LIMIT_BURST=40
# Swagger UI of the services (they are not reachable from the internet anyway).
API_DOCS_ENABLED=false

# ---- Backups (scripts/backup-db.sh, docs/DEPLOY.md section 12) -----------------------------------
BACKUP_DIR=/var/backups/rozklad
BACKUP_KEEP_DAYS=14
# age public key (age1...): dumps are encrypted on the server; the private key stays off the server.
BACKUP_AGE_RECIPIENT=
# rclone destination (remote:path) for an off-site copy of every dump; needs BACKUP_AGE_RECIPIENT.
BACKUP_RCLONE_REMOTE=
# Fetched after every successful backup (dead-man switch, e.g. https://hc-ping.com/<uuid>).
BACKUP_PING_URL=

# ---- Memory --------------------------------------------------------------------------------------
# The defaults in compose.prod.yml are caps, not reservations, and add up to about 5.6 GB. They are
# meant for 8 GB of RAM. A 4 GB VPS with 2 GB of swap is best effort and has not been measured: use
# GitHub-built images there (building on the VPS runs Maven and image builds next to the stack) and
# watch `docker stats`. On Oracle Ampere A1 Always Free (2 OCPU / 12 GB) uncomment this block: the caps add up
# to about 9.1 GB and leave about 3 GB for the OS, Docker and image pulls (the stack itself uses about 3.4 GB).
#POSTGRES_MEM_LIMIT=1g
#RABBITMQ_MEM_LIMIT=768m
#REDIS_MEM_LIMIT=256m
#REDIS_MAXMEMORY=192mb
#AUTH_MEM_LIMIT=768m
#AUTH_HEAP=384m
# CPUs the sign-in service may use at most (default 1, also on a large VM: a flood of sign-ins stays there)
#AUTH_CPUS=1
#CORE_MEM_LIMIT=1280m
#CORE_HEAP=896m
#SCHEDULER_MEM_LIMIT=2g
#SCHEDULER_HEAP=1280m
#IMPORTER_MEM_LIMIT=1g
#IMPORTER_HEAP=512m
# LibreOffice runs next to the JVM in notification: keep the heap at about 40 % of the cap
#NOTIFICATION_MEM_LIMIT=1280m
#NOTIFICATION_HEAP=512m
#GATEWAY_MEM_LIMIT=512m
#GATEWAY_HEAP=256m
#WEB_MEM_LIMIT=128m
#CADDY_MEM_LIMIT=256m
