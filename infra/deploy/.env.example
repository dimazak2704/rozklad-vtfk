# Production settings of «Розклад ВТФК» for one VPS (docs/DEPLOY.md). No real values here.
#
#   infra/deploy/scripts/gen-secrets.sh    creates infra/deploy/.env from this file and replaces
#                                          every "change-me" with a random value
#   then edit infra/deploy/.env: DOMAIN, ACME_EMAIL, Telegram and Anthropic keys
#
# infra/deploy/.env is gitignored: never commit it. Keep a copy in a password manager: a database
# backup cannot be used without the passwords and client secrets it was made with.
# Format: KEY=value, one per line, no quotes and no spaces around "=".

# ---- Public addresses ----------------------------------------------------------------------------
# Host name only (no https://, no path). The SPA is served at https://DOMAIN, Keycloak at
# https://auth.DOMAIN and, if API_SITE_ENABLED=1, the API at https://api.DOMAIN. All of these names
# must point to the VPS. Free options: <ip-with-dashes>.sslip.io (for 203.0.113.10 it is
# 203-0-113-10.sslip.io, nothing to register), <name>.duckdns.org, or a GitHub Student Pack domain.
DOMAIN=rozklad.example.com
# Let's Encrypt account e-mail (certificate expiry warnings). example.com addresses are refused.
ACME_EMAIL=admin@example.com
# Certificate authority. For the very first experiments you can use the staging CA (browsers will
# warn, but its rate limits are high): https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# A second origin of the SPA when the client is also hosted on Netlify, for example
# https://rozklad-vtfk.netlify.app (scheme + host, no trailing slash). Empty otherwise.
# It is added to CORS of the gateway and to the redirect URIs of the Keycloak client.
EXTRA_WEB_ORIGIN=
# 1 = also serve the API at https://api.DOMAIN (the Netlify-hosted SPA calls it). 0 = off.
API_SITE_ENABLED=0
# 1 = open the Keycloak admin console at https://auth.DOMAIN/admin/ (turn it off again after use).
KC_ADMIN_ALLOWED=0

# ---- Images ------------------------------------------------------------------------------------
# rozklad + prod: deploy.sh builds the images on the VPS (native architecture).
# ghcr.io/<github-user>/rozklad + <commit sha>: images built by .github/workflows/deploy.yml.
IMAGE_PREFIX=rozklad
IMAGE_TAG=prod

# ---- PostgreSQL: superuser and one user per service database ----------------------------------
# Applied when the database volume is created for the first time.
POSTGRES_PASSWORD=change-me
CORE_DB_PASSWORD=change-me
SCHEDULER_DB_PASSWORD=change-me
IMPORTER_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# ---- RabbitMQ and Redis --------------------------------------------------------------------------
RABBIT_USER=rozklad
RABBIT_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ---- Keycloak ------------------------------------------------------------------------------------
# Bootstrap administrator of the master realm, created on the very first start only.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secrets of the confidential clients used by the services. deploy.sh copies them into Keycloak.
CORE_ADMIN_CLIENT_SECRET=change-me
NOTIFICATION_CLIENT_SECRET=change-me
IMPORTER_CLIENT_SECRET=change-me

# ---- Demo accounts for the defense ---------------------------------------------------------------
# deploy.sh (scripts/create-demo-users.sh) creates admin (ADMIN) and krentsin, nepyivoda (TEACHER)
# in the realm "rozklad" with these passwords. Empty = the account stays disabled.
DEMO_ADMIN_PASSWORD=change-me
DEMO_TEACHER_PASSWORD=change-me

# ---- Telegram bot (notification) -----------------------------------------------------------------
# Token from @BotFather. One token can be polled by one instance only: stop the local bot first.
TELEGRAM_BOT_TOKEN=
# Chat id of the owner/dispatcher for service messages.
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=scheduler_vtfk_bot
# POLLING needs no inbound connection. WEBHOOK posts to https://DOMAIN/api/notify/telegram/webhook.
TELEGRAM_MODE=POLLING
# Checked in the X-Telegram-Bot-Api-Secret-Token header (WEBHOOK mode only).
TELEGRAM_WEBHOOK_SECRET=change-me

# ---- AI extraction (importer) --------------------------------------------------------------------
# Key from console.anthropic.com. Empty = AI import is unavailable, deterministic parsers still work.
ANTHROPIC_API_KEY=
AI_MODEL_TEXT=claude-haiku-5-5
AI_MODEL_VISION=claude-sonnet-5-5
AI_DAILY_BUDGET_USD=2.00

# ---- Gateway -------------------------------------------------------------------------------------
# Token bucket per client IP for /api/public/**.
PUBLIC_RATE_LIMIT_PER_SECOND=20
PUBLIC_RATE_LIMIT_BURST=40
# Swagger UI of the services (they are not reachable from the internet anyway).
API_DOCS_ENABLED=false

# ---- Backups (scripts/backup-db.sh) --------------------------------------------------------------
BACKUP_DIR=/var/backups/rozklad
BACKUP_KEEP_DAYS=14

# ---- Memory --------------------------------------------------------------------------------------
# The defaults in compose.prod.yml fit a 4 GB VPS (add 2 GB of swap there, see DEPLOY.md).
# On a large VM such as Oracle Ampere A1 with 24 GB, uncomment this block.
#POSTGRES_MEM_LIMIT=1g
#RABBITMQ_MEM_LIMIT=1g
#REDIS_MEM_LIMIT=256m
#REDIS_MAXMEMORY=192mb
#KEYCLOAK_MEM_LIMIT=2g
#CORE_MEM_LIMIT=1536m
#CORE_HEAP=1g
#SCHEDULER_MEM_LIMIT=3g
#SCHEDULER_HEAP=2g
#IMPORTER_MEM_LIMIT=1536m
#IMPORTER_HEAP=768m
#NOTIFICATION_MEM_LIMIT=1536m
#NOTIFICATION_HEAP=768m
#GATEWAY_MEM_LIMIT=768m
#GATEWAY_HEAP=384m
#WEB_MEM_LIMIT=128m
#CADDY_MEM_LIMIT=256m
