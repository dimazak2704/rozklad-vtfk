# Приклад налаштувань SPA (скопіюйте в .env.local за потреби). Секретів тут немає.
VITE_API_BASE=/api
# Сервіс входу (OIDC-видавець). Порожньо — той самий сайт: ${origin}/auth (nginx контейнера web, Caddy на сервері).
# npm run dev бере http://localhost:8088/auth з .env.development; vite preview (5181) — задайте те саме тут.
# VITE_OIDC_AUTHORITY=http://localhost:8088/auth
VITE_OIDC_CLIENT_ID=rozklad-web
VITE_OIDC_SCOPE=openid profile email
VITE_TELEGRAM_BOT_URL=https://t.me/scheduler_vtfk_bot
# Лише для npm run dev: фіктивний користувач без сервісу входу (ADMIN, TEACHER або обидві через кому)
# VITE_DEV_AUTH_ROLES=ADMIN
# Куди Vite-проксі веде /api (за замовчуванням gateway)
# VITE_DEV_API_TARGET=http://localhost:8080
# Мок-API без бекенду (MSW, src/mocks): npm run dev:mock або VITE_USE_MOCKS=1 (лише dev)
# VITE_USE_MOCKS=1
# VITE_MOCK_DELAY=real
