# Приклад налаштувань SPA (скопіюйте в .env.local за потреби). Секретів тут немає.
VITE_API_BASE=/api
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/rozklad
VITE_OIDC_CLIENT_ID=rozklad-web
VITE_OIDC_SCOPE=openid profile email
VITE_TELEGRAM_BOT_URL=https://t.me/scheduler_vtfk_bot
# Лише для npm run dev: фіктивний користувач без Keycloak (ADMIN, TEACHER або обидві через кому)
# VITE_DEV_AUTH_ROLES=ADMIN
# Куди Vite-проксі веде /api (за замовчуванням gateway)
# VITE_DEV_API_TARGET=http://localhost:8080
