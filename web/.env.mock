# Режим `npm run dev:mock` (vite --mode mock): SPA з мок-API (MSW, src/mocks) без бекенду і Keycloak.
# Секретів тут немає, тому файл у git (виняток у web/.gitignore). Локальні зміни — у .env.mock.local.
VITE_USE_MOCKS=1
# Фіктивний користувач для адмінки й кабінету; у вкладці можна змінити:
# sessionStorage.setItem('rozklad.mockRoles', 'TEACHER') і перезавантажити ('' — гість)
VITE_DEV_AUTH_ROLES=ADMIN,TEACHER
# Затримка відповідей: мс, real (100–400 мс) або infinite
VITE_MOCK_DELAY=real
