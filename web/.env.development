# Режим npm run dev (Vite на 5180): вхід через сервіс входу локального стенда (scripts/dev-stack.sh up),
# який браузер бачить через nginx контейнера web. Видавець фіксований, тому /auth Vite не проксіює.
# Секретів тут немає, тому файл у git (виняток у web/.gitignore). Локальні зміни — у .env.development.local.
VITE_OIDC_AUTHORITY=http://localhost:8088/auth
